{
  "manifest_version": 3,
  "name": "Simulador Mobile: Celular, Tablet e Smart TV",
  "short_name": "Simulador",
  "version": "1.5.0",
  "description": "Teste responsivo: visualize qualquer site no celular, tablet e Smart TV com moldura realista, teclado virtual, User-Agent e FPS.",
  "author": "Lucas Caldeira",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Simulador Mobile — abrir painel de dispositivos",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage",
    "tabs",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"]
}
